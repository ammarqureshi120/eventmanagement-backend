<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- AD-1: inbound adapter + composition root. Infrastructure is referenced for DI registration only. -->
  <PropertyGroup>
    <RootNamespace>EventHub.Api</RootNamespace>
    <UserSecretsId>eventhub-api-6f0d2c1e</UserSecretsId>
  </PropertyGroup>

  <!-- AD-4: build-time OpenAPI 3.0 document, committed at backend/openapi/openapi.json. -->
  <PropertyGroup>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--openapi-version OpenApi3_0 --file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <!-- MSG0005: notifications may have no handler yet (DomainEventNotification until the first domain-event handler). -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);MSG0005</NoWarn>
  </PropertyGroup>

  <!--
    No InternalsVisibleTo: the Api's generated Mediator is internal, and the integration tests generate their own
    (TestPipeline). With internals visible, both AddMediator extensions would collide in the test assembly.
  -->

  <ItemGroup>
    <ProjectReference Include="..\EventHub.Application\EventHub.Application.csproj" />
    <ProjectReference Include="..\EventHub.Contracts\EventHub.Contracts.csproj" />
    <ProjectReference Include="..\EventHub.Infrastructure\EventHub.Infrastructure.csproj" />
    <ProjectReference Include="..\EventHub.ServiceDefaults\EventHub.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <!-- AD-5: source-generated Mediator; the generator runs in the composition root only. -->
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <!-- dotnet ef startup project (migrations live in Infrastructure). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
  </ItemGroup>

</Project>
