<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Architecture tests (AD-1) inspect every runtime project. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\EventHub.Domain\EventHub.Domain.csproj" />
    <ProjectReference Include="..\..\src\EventHub.Contracts\EventHub.Contracts.csproj" />
    <ProjectReference Include="..\..\src\EventHub.Application\EventHub.Application.csproj" />
    <ProjectReference Include="..\..\src\EventHub.Infrastructure\EventHub.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\EventHub.Api\EventHub.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="NetArchTest.Rules" />
    <!-- No Mediator generator here: PipelineOrderTests inspects the Api's generated registration. -->
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
